#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
S_0x6308305cf350 .scope module, "switch_inv_tb" "switch_inv_tb" 2 3;
 .timescale -9 -12;
v0x6308305df9f0_0 .var "i", 0 0;
RS_0x7bb7de0e60a8 .resolv tri, L_0x6308305dfb90, L_0x6308305dfcf0;
v0x6308305dfac0_0 .net8 "o", 0 0, RS_0x7bb7de0e60a8;  2 drivers, strength-aware
S_0x6308305cf4e0 .scope module, "dut" "switch_inv" 2 8, 3 1 0, S_0x6308305cf350;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "i";
    .port_info 1 /OUTPUT 1 "o";
L_0x7bb7de09d018 .functor BUFT 1, C4<1>, C4<0>, C4<0>, C4<0>;
L_0x6308305dfb90 .functor PMOS 1, L_0x7bb7de09d018, v0x6308305df9f0_0, C4<0>, C4<0>;
L_0x7bb7de09d060 .functor BUFT 1, C4<0>, C4<0>, C4<0>, C4<0>;
L_0x6308305dfcf0 .functor NMOS 1, L_0x7bb7de09d060, v0x6308305df9f0_0, C4<0>, C4<0>;
v0x6308305cf6c0_0 .net/2u *"_ivl_1", 0 0, L_0x7bb7de09d018;  1 drivers
v0x6308305df750_0 .net/2u *"_ivl_4", 0 0, L_0x7bb7de09d060;  1 drivers
v0x6308305df830_0 .net "i", 0 0, v0x6308305df9f0_0;  1 drivers
v0x6308305df8d0_0 .net8 "o", 0 0, RS_0x7bb7de0e60a8;  alias, 2 drivers, strength-aware
    .scope S_0x6308305cf350;
T_0 ;
    %vpi_call 2 11 "$dumpfile", "inv.vcd" {0 0 0};
    %vpi_call 2 12 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x6308305cf350 {0 0 0};
    %vpi_call 2 14 "$monitor", "i=%b | o=%b", v0x6308305df9f0_0, v0x6308305dfac0_0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x6308305df9f0_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x6308305df9f0_0, 0, 1;
    %delay 10000, 0;
    %vpi_call 2 19 "$finish" {0 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "switch_inv_tb.v";
    "switch_inv.v";
