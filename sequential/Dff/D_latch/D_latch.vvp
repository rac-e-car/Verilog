#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
S_0x59897ce79780 .scope module, "d_latch_tb" "d_latch_tb" 2 1;
 .timescale 0 0;
v0x59897ce8b830_0 .var "D", 0 0;
v0x59897ce8b900_0 .var "E", 0 0;
v0x59897ce8b9d0_0 .net "q", 0 0, v0x59897ce8b710_0;  1 drivers
S_0x59897ce79910 .scope module, "dut" "d_latch" 2 6, 3 1 0, S_0x59897ce79780;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "D";
    .port_info 1 /INPUT 1 "E";
    .port_info 2 /OUTPUT 1 "q";
v0x59897ce79b40_0 .net "D", 0 0, v0x59897ce8b830_0;  1 drivers
v0x59897ce8b650_0 .net "E", 0 0, v0x59897ce8b900_0;  1 drivers
v0x59897ce8b710_0 .var "q", 0 0;
E_0x59897ce40dc0 .event anyedge, v0x59897ce8b650_0, v0x59897ce79b40_0;
    .scope S_0x59897ce79910;
T_0 ;
    %wait E_0x59897ce40dc0;
    %load/vec4 v0x59897ce8b650_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %load/vec4 v0x59897ce79b40_0;
    %assign/vec4 v0x59897ce8b710_0, 0;
T_0.0 ;
    %jmp T_0;
    .thread T_0, $push;
    .scope S_0x59897ce79780;
T_1 ;
    %vpi_call 2 9 "$dumpfile", "d_latch.vcd" {0 0 0};
    %vpi_call 2 10 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x59897ce79780 {0 0 0};
    %vpi_call 2 12 "$monitor", "At time=%0t-->| D=%d, E=%d, q=%d", $time, v0x59897ce8b830_0, v0x59897ce8b900_0, v0x59897ce8b9d0_0 {0 0 0};
    %pushi/vec4 3, 0, 32;
T_1.0 %dup/vec4;
    %pushi/vec4 0, 0, 32;
    %cmp/s;
    %jmp/1xz T_1.1, 5;
    %jmp/1 T_1.1, 4;
    %pushi/vec4 1, 0, 32;
    %sub;
    %vpi_func 2 15 "$random" 32 {0 0 0};
    %pad/s 1;
    %store/vec4 v0x59897ce8b830_0, 0, 1;
    %delay 10, 0;
    %vpi_func 2 16 "$random" 32 {0 0 0};
    %pad/s 1;
    %store/vec4 v0x59897ce8b900_0, 0, 1;
    %delay 10, 0;
    %jmp T_1.0;
T_1.1 ;
    %pop/vec4 1;
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 4;
