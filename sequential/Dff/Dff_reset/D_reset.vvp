#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
S_0x58334ebfb0f0 .scope module, "D_reset_tb" "D_reset_tb" 2 1;
 .timescale 0 0;
v0x58334ec0ec80_0 .var "clk", 0 0;
v0x58334ec0ed40_0 .var "d", 0 0;
v0x58334ec0ee10_0 .net "q", 0 0, v0x58334ec0e940_0;  1 drivers
v0x58334ec0ef10_0 .net "qbar", 0 0, v0x58334ec0ea10_0;  1 drivers
v0x58334ec0efe0_0 .var "reset", 0 0;
E_0x58334ebc26a0 .event negedge, v0x58334ebfb4a0_0;
S_0x58334ebfb2a0 .scope module, "dut" "D_reset" 2 6, 3 1 0, S_0x58334ebfb0f0;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "d";
    .port_info 1 /INPUT 1 "clk";
    .port_info 2 /INPUT 1 "reset";
    .port_info 3 /OUTPUT 1 "q";
    .port_info 4 /OUTPUT 1 "qbar";
v0x58334ebfb4a0_0 .net "clk", 0 0, v0x58334ec0ec80_0;  1 drivers
v0x58334ec0e880_0 .net "d", 0 0, v0x58334ec0ed40_0;  1 drivers
v0x58334ec0e940_0 .var "q", 0 0;
v0x58334ec0ea10_0 .var "qbar", 0 0;
v0x58334ec0ead0_0 .net "reset", 0 0, v0x58334ec0efe0_0;  1 drivers
E_0x58334ebc2060 .event posedge, v0x58334ebfb4a0_0;
    .scope S_0x58334ebfb2a0;
T_0 ;
    %wait E_0x58334ebc2060;
    %load/vec4 v0x58334ec0ead0_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 1, 0, 2;
    %split/vec4 1;
    %assign/vec4 v0x58334ec0ea10_0, 0;
    %assign/vec4 v0x58334ec0e940_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x58334ec0e880_0;
    %load/vec4 v0x58334ec0e880_0;
    %inv;
    %concat/vec4; draw_concat_vec4
    %split/vec4 1;
    %assign/vec4 v0x58334ec0ea10_0, 0;
    %assign/vec4 v0x58334ec0e940_0, 0;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x58334ebfb0f0;
T_1 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x58334ec0ec80_0, 0, 1;
    %end;
    .thread T_1;
    .scope S_0x58334ebfb0f0;
T_2 ;
    %delay 5, 0;
    %load/vec4 v0x58334ec0ec80_0;
    %inv;
    %store/vec4 v0x58334ec0ec80_0, 0, 1;
    %jmp T_2;
    .thread T_2;
    .scope S_0x58334ebfb0f0;
T_3 ;
    %vpi_call 2 12 "$dumpfile", "d_r.vcd" {0 0 0};
    %vpi_call 2 13 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x58334ebfb0f0 {0 0 0};
    %vpi_call 2 15 "$monitor", "At time=%0t-->| clk=%b, d=%b, reset=%b| q=%b, qbar=%b", $time, v0x58334ec0ec80_0, v0x58334ec0ed40_0, v0x58334ec0efe0_0, v0x58334ec0ee10_0, v0x58334ec0ef10_0 {0 0 0};
    %pushi/vec4 10, 0, 32;
T_3.0 %dup/vec4;
    %pushi/vec4 0, 0, 32;
    %cmp/s;
    %jmp/1xz T_3.1, 5;
    %jmp/1 T_3.1, 4;
    %pushi/vec4 1, 0, 32;
    %sub;
    %wait E_0x58334ebc26a0;
    %vpi_func 2 19 "$random" 32 {0 0 0};
    %pad/s 1;
    %store/vec4 v0x58334ec0ed40_0, 0, 1;
    %vpi_func 2 20 "$random" 32 {0 0 0};
    %pad/s 1;
    %store/vec4 v0x58334ec0efe0_0, 0, 1;
    %jmp T_3.0;
T_3.1 ;
    %pop/vec4 1;
    %delay 10, 0;
    %vpi_call 2 22 "$finish" {0 0 0};
    %end;
    .thread T_3;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "D_reset_tb.v";
    "Dff_reset.v";
