#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
S_0x63d240d97990 .scope module, "D_ff_tb" "D_ff_tb" 2 1;
 .timescale 0 0;
v0x63d240daa6d0_0 .var "clk", 0 0;
v0x63d240daa790_0 .var "d", 0 0;
v0x63d240daa860_0 .net "q", 0 0, v0x63d240daa490_0;  1 drivers
v0x63d240daa960_0 .net "qbar", 0 0, v0x63d240daa560_0;  1 drivers
E_0x63d240d5eb60 .event negedge, v0x63d240d5e490_0;
S_0x63d240d97b40 .scope module, "dut" "D_ff" 2 6, 3 1 0, S_0x63d240d97990;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "d";
    .port_info 1 /INPUT 1 "clk";
    .port_info 2 /OUTPUT 1 "q";
    .port_info 3 /OUTPUT 1 "qbar";
v0x63d240d5e490_0 .net "clk", 0 0, v0x63d240daa6d0_0;  1 drivers
v0x63d240daa3d0_0 .net "d", 0 0, v0x63d240daa790_0;  1 drivers
v0x63d240daa490_0 .var "q", 0 0;
v0x63d240daa560_0 .var "qbar", 0 0;
E_0x63d240d5f6a0 .event posedge, v0x63d240d5e490_0;
    .scope S_0x63d240d97b40;
T_0 ;
    %wait E_0x63d240d5f6a0;
    %load/vec4 v0x63d240daa3d0_0;
    %assign/vec4 v0x63d240daa490_0, 0;
    %load/vec4 v0x63d240daa3d0_0;
    %inv;
    %assign/vec4 v0x63d240daa560_0, 0;
    %jmp T_0;
    .thread T_0;
    .scope S_0x63d240d97990;
T_1 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x63d240daa6d0_0, 0, 1;
    %end;
    .thread T_1;
    .scope S_0x63d240d97990;
T_2 ;
    %delay 5, 0;
    %load/vec4 v0x63d240daa6d0_0;
    %inv;
    %store/vec4 v0x63d240daa6d0_0, 0, 1;
    %jmp T_2;
    .thread T_2;
    .scope S_0x63d240d97990;
T_3 ;
    %vpi_call 2 12 "$dumpfile", "D_ff.vcd" {0 0 0};
    %vpi_call 2 13 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x63d240d97990 {0 0 0};
    %vpi_call 2 15 "$monitor", "At time-%0t-->| clk=%b d=%b, q=%b, qbar=%b", $time, v0x63d240daa6d0_0, v0x63d240daa790_0, v0x63d240daa860_0, v0x63d240daa960_0 {0 0 0};
    %pushi/vec4 8, 0, 32;
T_3.0 %dup/vec4;
    %pushi/vec4 0, 0, 32;
    %cmp/s;
    %jmp/1xz T_3.1, 5;
    %jmp/1 T_3.1, 4;
    %pushi/vec4 1, 0, 32;
    %sub;
    %wait E_0x63d240d5eb60;
    %vpi_func 2 20 "$random" 32 {0 0 0};
    %pad/s 1;
    %store/vec4 v0x63d240daa790_0, 0, 1;
    %jmp T_3.0;
T_3.1 ;
    %pop/vec4 1;
    %delay 10, 0;
    %vpi_call 2 23 "$finish" {0 0 0};
    %end;
    .thread T_3;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "D_ff_tb.v";
    "D_ff.v";
